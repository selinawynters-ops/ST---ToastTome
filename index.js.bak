import { extension_settings } from '../../../extensions.js';
import { SlashCommand } from '../../../slash-commands/SlashCommand.js';
import { SlashCommandParser } from '../../../slash-commands/SlashCommandParser.js';
import { Settings } from './src/Settings.js';

/**
 * Toast Tome — DreamTavern Toast History Extension
 * Grimoire-Heavy aesthetic with hologram precision
 */

const settings = new Settings();
const EXTENSION_NAMES = [
    'SillyTavern-ToastTome',
    'third-party/SillyTavern-ToastTome',
    'SillyTavern-ToastTome/SillyTavern-ToastTome',
    'third-party/SillyTavern-ToastTome/SillyTavern-ToastTome',
];
const PATCH_FLAG = '__toastTomeToastrPatched';
const ORIGINALS_FLAG = '__toastTomeToastrOriginals';
const WRAP_FLAG = '__toastTomeWrapped';
const RETRY_PATCH_DELAY_MS = 700;
const WATCHDOG_PATCH_INTERVAL_MS = 4000;

// Level metadata
const LEVEL_META = {
    error:   { icon: '🔥', label: 'ERROR', class: 'tt-err' },
    warning: { icon: '⚠️', label: 'WARN',  class: 'tt-wrn' },
    success: { icon: '✨', label: 'OK',     class: 'tt-suc' },
    info:    { icon: '📡', label: 'INFO',   class: 'tt-inf' },
};

const DEFAULT_TIMEOUTS = {
    error: 10000,
    warning: 8500,
    success: 8500,
    info: 6500,
};

/** Live in-memory history (for onclick handlers etc) */
const liveHistory = [];
let totalCount = 0;
let suppressedCount = 0;
let panelOpen = false;
let activeFilter = 'ALL';
let searchQuery = '';
let mountRetryTimer = null;
let patchRetryTimer = null;
let patchWatchdogTimer = null;

// ─── DOM References ─────────────────────────────────────────
let badgeEl = null;
let badgeCountEl = null;
let panelEl = null;
let panelBodyEl = null;
let panelFooterInfo = null;
let suppressionManagerEl = null;
let suppressionManagerBodyEl = null;
let suppressionManagerOpen = false;

// ─── Helpers ─────────────────────────────────────────────────
function escapeHtml(str) {
    if (!str) return '';
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

function normalizeText(str) {
    return String(str || '').replace(/\s+/g, ' ').trim();
}

function formatBadgeCount(count) {
    return count > 99 ? '99+' : String(count);
}

function getUnreadCount() {
    return Math.max(0, Number.parseInt(settings.unreadCount, 10) || 0);
}

function loadMobileStylesheet() {
    if (document.getElementById('toast-tome-mobile-styles')) return;

    const link = document.createElement('link');
    link.id = 'toast-tome-mobile-styles';
    link.rel = 'stylesheet';
    link.type = 'text/css';
    link.href = new URL('./mobile-styles.css', import.meta.url).href;
    document.head.appendChild(link);
}

function shouldSkipCapture(options) {
    return Boolean(options?.toastTomeSkipCapture || options?.ttSkipCapture);
}

function highlightSearch(text) {
    const escapedText = escapeHtml(text || '');
    if (!searchQuery) return escapedText;

    const escapedQuery = escapeHtml(searchQuery).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    if (!escapedQuery) return escapedText;

    return escapedText.replace(new RegExp(`(${escapedQuery})`, 'ig'), '<mark class="tt-search-hit">$1</mark>');
}

function extractText(msgInput) {
    if (!msgInput) return '';
    if (typeof msgInput === 'string') return msgInput;
    // jQuery object or DOM node
    if (msgInput instanceof HTMLElement) return msgInput.textContent || '';
    if (msgInput.jquery || msgInput[0]) {
        const el = msgInput[0] || msgInput;
        return el.textContent || el.innerText || '';
    }
    return String(msgInput);
}

function formatTime(isoString) {
    const d = new Date(isoString);
    const now = new Date();
    const isToday = d.toDateString() === now.toDateString();
    if (isToday) {
        return d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit', hour12: true });
    }
    return d.toLocaleDateString([], { month: 'short', day: 'numeric' }) + ' ' +
           d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit', hour12: true });
}

function toRoman(num) {
    if (num <= 0 || num > 3999) return String(num);
    const vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];
    const syms = ['M', 'CM', 'D', 'CD', 'C', 'XC', 'L', 'XL', 'X', 'IX', 'V', 'IV', 'I'];
    let result = '';
    for (let i = 0; i < vals.length; i++) {
        while (num >= vals[i]) {
            result += syms[i];
            num -= vals[i];
        }
    }
    return result;
}

// ─── Badge ───────────────────────────────────────────────────
function createBadge() {
    document.querySelectorAll('.tt-badge').forEach(el => el.remove());

    badgeEl = document.createElement('div');
    badgeEl.classList.add('tt-badge');
    badgeEl.title = 'Toast Tome — Click to open';
    badgeEl.innerHTML = `
        <span class="tt-badge-icon">🏮</span>
        <span class="tt-badge-count" style="display:none;">0</span>
    `;
    badgeCountEl = badgeEl.querySelector('.tt-badge-count');
    badgeEl.addEventListener('click', (e) => {
        e.stopPropagation();
        togglePanel();
    });

    // Insert into top settings holder
    const holder = document.querySelector('#top-settings-holder');
    if (holder) {
        holder.prepend(badgeEl);
    } else {
        badgeEl.classList.add('tt-badge--floating');
        document.body.appendChild(badgeEl);
    }
}

function updateBadge() {
    if (!badgeEl || !badgeCountEl) return;

    const unreadCount = getUnreadCount();
    if (unreadCount > 0) {
        badgeEl.classList.add('tt-badge--visible');
        badgeCountEl.textContent = formatBadgeCount(unreadCount);
        badgeCountEl.style.display = '';
        badgeEl.classList.add('tt-badge--active');
    } else {
        badgeEl.classList.remove('tt-badge--visible');
        badgeCountEl.style.display = 'none';
        badgeEl.classList.remove('tt-badge--active');
    }
    // Update pill width for double-digits
    if (unreadCount >= 10) {
        badgeCountEl.classList.add('tt-badge-count--wide');
    } else {
        badgeCountEl.classList.remove('tt-badge-count--wide');
    }
}

// ─── Panel size persistence ───────────────────────────────────
const TT_SIZE_KEY = 'tt_panel_size';

function loadPanelSize() {
    try {
        const saved = localStorage.getItem(TT_SIZE_KEY);
        if (saved) return JSON.parse(saved);
    } catch { /* ignore */ }
    return null;
}

function savePanelSize(height, width) {
    try {
        localStorage.setItem(TT_SIZE_KEY, JSON.stringify({ height, width }));
    } catch { /* ignore */ }
}

function applyPanelSize(el) {
    const saved = loadPanelSize();
    if (!saved) return;
    const maxH = window.innerHeight - 64;
    const maxW = window.innerWidth - 24;
    if (saved.height) el.style.height = Math.min(saved.height, maxH) + 'px';
    if (saved.width)  el.style.width  = Math.min(saved.width,  maxW) + 'px';
}

function attachResizeHandle(el) {
    const handle = el.querySelector('.tt-resize-handle');
    if (!handle) return;

    let startY, startX, startH, startW;

    function onMove(e) {
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const maxH = window.innerHeight - 64;
        const maxW = window.innerWidth - 24;
        const newH = Math.min(maxH, Math.max(200, startH + (clientY - startY)));
        const newW = Math.min(maxW, Math.max(280, startW - (clientX - startX)));
        el.style.height = newH + 'px';
        el.style.width  = newW + 'px';
    }

    function onEnd(e) {
        handle.classList.remove('tt-resizing');
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onEnd);
        document.removeEventListener('touchmove', onMove);
        document.removeEventListener('touchend', onEnd);
        const h = parseInt(el.style.height);
        const w = parseInt(el.style.width);
        if (!isNaN(h) && !isNaN(w)) savePanelSize(h, w);
    }

    handle.addEventListener('mousedown', (e) => {
        e.preventDefault();
        startY = e.clientY; startX = e.clientX;
        startH = el.offsetHeight; startW = el.offsetWidth;
        handle.classList.add('tt-resizing');
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onEnd);
    });

    handle.addEventListener('touchstart', (e) => {
        e.preventDefault();
        startY = e.touches[0].clientY; startX = e.touches[0].clientX;
        startH = el.offsetHeight; startW = el.offsetWidth;
        handle.classList.add('tt-resizing');
        document.addEventListener('touchmove', onMove, { passive: false });
        document.addEventListener('touchend', onEnd);
    }, { passive: false });
}

// ─── Panel ───────────────────────────────────────────────────
function createPanel() {
    document.querySelectorAll('.tt-panel').forEach(el => el.remove());

    panelEl = document.createElement('div');
    panelEl.classList.add('tt-panel');
    panelEl.innerHTML = `
        <div class="tt-panel-glow-top"></div>
        <div class="tt-titlebar">
            <span class="tt-ornament">◆───</span>
            <span class="tt-title-icon">🏮</span>
            <span class="tt-title-text">Toast Tome</span>
            <span class="tt-ornament">───◆</span>
            <span class="tt-title-badge">0</span>
            <button class="tt-popup-close" type="button" title="Close Toast Tome" aria-label="Close Toast Tome">×</button>
        </div>
        <div class="tt-toolbar">
            <div class="tt-search">
                <span class="tt-search-icon">🔍</span>
                <input type="text" class="tt-search-input" placeholder="Search the tome..." />
            </div>
            <div class="tt-filters">
                <span class="tt-pill tt-pill--active" data-filter="ALL">ALL</span>
                <span class="tt-pill" data-filter="error">ERR</span>
                <span class="tt-pill" data-filter="warning">WARN</span>
                <span class="tt-pill" data-filter="success">OK</span>
                <span class="tt-pill" data-filter="info">INFO</span>
            </div>
        </div>
        <section class="tt-suppression-manager" aria-hidden="true">
            <div class="tt-suppression-manager-header">
                <div>
                    <div class="tt-suppression-manager-kicker">Concealments</div>
                    <div class="tt-suppression-manager-title">Suppressed Notices</div>
                </div>
                <button class="tt-btn tt-btn--danger" data-action="restore-all" type="button">Restore All</button>
            </div>
            <div class="tt-suppression-manager-body"></div>
        </section>
        <div class="tt-body"></div>
        <div class="tt-footer">
            <span class="tt-footer-info"></span>
            <div class="tt-footer-btns">
                <button class="tt-btn tt-btn--ghost" data-action="concealments" title="Review suppressed toast patterns">Concealments</button>
                <button class="tt-btn tt-btn--ghost" data-action="export" title="Export toast history as text">Transcribe</button>
                <button class="tt-btn tt-btn--danger" data-action="clear" title="Clear all toast history">Erase</button>
                <button class="tt-btn tt-btn--primary" data-action="close" title="Close the Toast Tome">Seal</button>
            </div>
        </div>
        <div class="tt-resize-handle" title="Drag to resize"></div>
    `;

    panelBodyEl = panelEl.querySelector('.tt-body');
    panelFooterInfo = panelEl.querySelector('.tt-footer-info');
    suppressionManagerEl = panelEl.querySelector('.tt-suppression-manager');
    suppressionManagerBodyEl = panelEl.querySelector('.tt-suppression-manager-body');

    // Search
    const searchInput = panelEl.querySelector('.tt-search-input');
    searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase();
        renderEntries();
    });

    // Filter pills
    panelEl.querySelectorAll('.tt-pill').forEach(pill => {
        pill.addEventListener('click', () => {
            panelEl.querySelectorAll('.tt-pill').forEach(p => p.classList.remove('tt-pill--active'));
            pill.classList.add('tt-pill--active');
            activeFilter = pill.dataset.filter;
            renderEntries();
        });
    });

    // Footer buttons
    panelEl.querySelector('.tt-popup-close').addEventListener('click', closePanel);
    panelEl.querySelector('[data-action="concealments"]').addEventListener('click', () => {
        if (suppressionManagerOpen) {
            closeSuppressionManager();
        } else {
            openSuppressionManager();
        }
    });
    panelEl.querySelector('[data-action="restore-all"]').addEventListener('click', () => {
        settings.clearBlocks();
        updateBadge();
        renderSuppressionManager();
    });
    suppressionManagerBodyEl.addEventListener('click', (e) => {
        const button = e.target.closest('[data-action="allow-again"]');
        if (!button || !suppressionManagerBodyEl.contains(button)) return;
        settings.removeBlock(button.dataset.level, button.dataset.text);
        updateBadge();
        renderSuppressionManager();
    });
    panelEl.querySelector('[data-action="export"]').addEventListener('click', exportHistory);
    panelEl.querySelector('[data-action="clear"]').addEventListener('click', () => {
        settings.clearHistory();
        liveHistory.length = 0;
        totalCount = 0;
        suppressedCount = 0;
        updateBadge();
        renderEntries();
    });
    panelEl.querySelector('[data-action="close"]').addEventListener('click', closePanel);

    // Prevent clicks inside panel from closing it
    panelEl.addEventListener('click', (e) => e.stopPropagation());

    document.body.appendChild(panelEl);

    // Apply saved size (overrides CSS default), then attach resize handle
    applyPanelSize(panelEl);
    attachResizeHandle(panelEl);
}

function togglePanel() {
    if (panelOpen) {
        closePanel();
    } else {
        openPanel();
    }
}

function openPanel() {
    if (!panelEl || !badgeEl) return;

    panelOpen = true;
    panelEl.classList.add('tt-panel--open');
    badgeEl.classList.add('tt-badge--panel-open');
    renderEntries();

    // Close on outside click
    setTimeout(() => {
        document.addEventListener('click', handleOutsideClick);
    }, 50);
}

function closePanel() {
    if (!panelEl || !badgeEl) return;

    closeSuppressionManager();
    panelOpen = false;
    panelEl.classList.remove('tt-panel--open');
    badgeEl.classList.remove('tt-badge--panel-open');
    document.removeEventListener('click', handleOutsideClick);
}

function openSuppressionManager() {
    if (!panelEl || !suppressionManagerEl) return;
    suppressionManagerOpen = true;
    panelEl.classList.add('tt-panel--managing');
    suppressionManagerEl.setAttribute('aria-hidden', 'false');
    panelEl.querySelector('[data-action="concealments"]').textContent = 'Inscriptions';
    renderSuppressionManager();
}

function closeSuppressionManager() {
    if (!panelEl || !suppressionManagerEl) return;
    suppressionManagerOpen = false;
    panelEl.classList.remove('tt-panel--managing');
    suppressionManagerEl.setAttribute('aria-hidden', 'true');
    const button = panelEl.querySelector('[data-action="concealments"]');
    if (button) button.textContent = 'Concealments';
    if (panelOpen) renderEntries();
}

function renderSuppressionManager() {
    if (!suppressionManagerBodyEl) return;

    const blocks = [...settings.hideList];
    suppressionManagerBodyEl.innerHTML = '';

    const restoreAllButton = panelEl?.querySelector('[data-action="restore-all"]');
    if (restoreAllButton) restoreAllButton.disabled = blocks.length === 0;

    if (blocks.length === 0) {
        suppressionManagerBodyEl.innerHTML = `
            <div class="tt-empty tt-suppression-empty">
                <span class="tt-empty-icon">◇</span>
                <span class="tt-empty-text">No concealed notices</span>
                <span class="tt-suppression-empty-detail">Anything you suppress will be recorded here so it can be allowed again.</span>
            </div>`;
    } else {
        for (const block of blocks) {
            const meta = LEVEL_META[block.level] || LEVEL_META.info;
            const item = document.createElement('article');
            item.className = 'tt-suppression-item';
            item.innerHTML = `
                <span class="tt-entry-icon">${meta.icon}</span>
                <div class="tt-suppression-copy">
                    <span class="tt-severity tt-severity--${meta.class}">${meta.label}</span>
                    <span class="tt-suppression-text">${escapeHtml(block.textContent)}</span>
                </div>
                <button class="tt-btn tt-btn--ghost tt-allow-again" data-action="allow-again" type="button">Allow Again</button>`;
            const button = item.querySelector('[data-action="allow-again"]');
            button.dataset.level = block.level;
            button.dataset.text = block.textContent;
            suppressionManagerBodyEl.appendChild(item);
        }
    }

    panelFooterInfo.textContent = `${toRoman(blocks.length)} concealment${blocks.length !== 1 ? 's' : ''}`;
}

function handleOutsideClick(e) {
    if (!panelEl.contains(e.target) && !badgeEl.contains(e.target)) {
        closePanel();
    }
}

function renderEntries() {
    if (!panelBodyEl) return;

    let entries = [...settings.history].reverse();
    const allCount = entries.length;
    suppressedCount = entries.filter(h => settings.isBlocked(h.level, h.body)).length;

    // Apply filter
    if (activeFilter !== 'ALL') {
        entries = entries.filter(h => h.level === activeFilter);
    }

    // Apply search
    if (searchQuery) {
        entries = entries.filter(h =>
            (h.title && h.title.toLowerCase().includes(searchQuery)) ||
            (h.body && h.body.toLowerCase().includes(searchQuery))
        );
    }

    panelBodyEl.innerHTML = '';

    if (entries.length === 0) {
        const empty = document.createElement('div');
        empty.classList.add('tt-empty');
        empty.innerHTML = `<span class="tt-empty-icon">📜</span><span class="tt-empty-text">${
            allCount === 0 ? 'The tome is empty — no inscriptions yet' : 'No inscriptions match your search'
        }</span>`;
        panelBodyEl.appendChild(empty);
    } else {
        for (const entry of entries) {
            const meta = LEVEL_META[entry.level] || LEVEL_META.info;
            const isSuppressed = settings.isBlocked(entry.level, entry.body);

            const el = document.createElement('div');
            el.classList.add('tt-entry');
            if (isSuppressed) el.classList.add('tt-entry--suppressed');

            el.innerHTML = `
                <div class="tt-marker tt-marker--${meta.class}"></div>
                <span class="tt-entry-icon">${meta.icon}</span>
                <div class="tt-entry-content">
                    <div class="tt-entry-title-row">
                        <span class="tt-entry-title">${highlightSearch(entry.title || entry.body?.substring(0, 50) || 'Toast')}</span>
                        <span class="tt-severity tt-severity--${meta.class}">${meta.label}</span>
                    </div>
                    <div class="tt-entry-body">${highlightSearch(entry.body)}</div>
                </div>
                <div class="tt-entry-meta">
                    <span class="tt-entry-time">${formatTime(entry.timestamp)}</span>
                    <div class="tt-entry-actions">
                        <button class="tt-action tt-action--copy" title="Copy to clipboard">⎘</button>
                        <button class="tt-action tt-action--suppress" title="${isSuppressed ? 'Unsuppress this toast' : 'Suppress future toasts like this'}">⊘</button>
                    </div>
                </div>
            `;

            // Copy action
            el.querySelector('.tt-action--copy').addEventListener('click', (e) => {
                e.stopPropagation();
                const text = `[${meta.label}] ${entry.title ? entry.title + ': ' : ''}${entry.body}`;
                copyText(text)
                    .then(() => notifyInternal('info', 'Copied to clipboard', 'Toast Tome', { timeOut: 1500 }))
                    .catch(() => notifyInternal('warning', 'Clipboard copy failed.', 'Toast Tome', { timeOut: 1800 }));
            });

            // Suppress action
            el.querySelector('.tt-action--suppress').addEventListener('click', (e) => {
                e.stopPropagation();
                if (isSuppressed) {
                    settings.removeBlock(entry.level, entry.body);
                } else {
                    settings.addBlock(entry.level, entry.body);
                }
                updateBadge();
                renderEntries();
            });

            panelBodyEl.appendChild(el);
        }
    }

    // Update footer
    const romanAll = toRoman(allCount);
    const romanSuppressed = toRoman(suppressedCount);
    const visibleText = searchQuery || activeFilter !== 'ALL'
        ? `Showing ${entries.length} of ${romanAll} inscription${allCount !== 1 ? 's' : ''}`
        : `${romanAll} inscription${allCount !== 1 ? 's' : ''}`;
    panelFooterInfo.textContent = `${visibleText} · ${romanSuppressed} concealed`;

    // Update title badge
    const titleBadge = panelEl.querySelector('.tt-title-badge');
    if (titleBadge) {
        titleBadge.textContent = formatBadgeCount(allCount);
    }
}

async function copyText(text) {
    if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return;
    }

    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();

    try {
        if (!document.execCommand('copy')) {
            throw new Error('Copy command failed');
        }
    } finally {
        textarea.remove();
    }
}

function exportHistory() {
    const lines = settings.history.map(h => {
        const meta = LEVEL_META[h.level] || LEVEL_META.info;
        const time = new Date(h.timestamp).toLocaleString();
        return `[${time}] [${meta.label}] ${h.title ? h.title + ': ' : ''}${h.body}`;
    });
    const text = `Toast Tome Export — ${new Date().toLocaleString()}\n${'═'.repeat(50)}\n\n${lines.join('\n')}`;

    // Download as file
    const blob = new Blob([text], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `toast-tome-${new Date().toISOString().slice(0, 10)}.txt`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
}

function notifyInternal(level, message, title, options = {}) {
    const method = window.toastr?.[level];
    if (typeof method === 'function') {
        return method.call(window.toastr, message, title, { ...options, toastTomeSkipCapture: true });
    }
    return undefined;
}

// Toast Tome keeps toastr as the app-wide notification API, then overrides
// its presentation, history capture, and suppression behavior in one place.
function interceptToastr() {
    if (!window.toastr) {
        return false;
    }

    const toastApi = window.toastr;
    if (!toastApi.options || typeof toastApi.options !== 'object') {
        toastApi.options = {};
    }
    toastApi.options.positionClass = 'toast-top-center';
    toastApi.options.newestOnTop = true;

    const originals = (typeof toastApi[ORIGINALS_FLAG] === 'object' && toastApi[ORIGINALS_FLAG] !== null)
        ? toastApi[ORIGINALS_FLAG]
        : {};

    let allLevelsWrapped = true;

    for (const level of Object.keys(LEVEL_META)) {
        if (typeof toastApi[level] !== 'function') continue;
        if (toastApi[level][WRAP_FLAG] === true) continue;
        allLevelsWrapped = false;

        const original = typeof originals[level] === 'function'
            ? originals[level]
            : toastApi[level].bind(toastApi);
        originals[level] = original;

        const wrapped = (message, title, options = {}) => {
            const bodyText = normalizeText(extractText(typeof message === 'string' ? (() => {
                const tmp = document.createElement('div');
                tmp.innerHTML = message;
                return tmp;
            })() : message));
            const titleText = normalizeText(extractText(title || ''));

            if (bodyText && settings.isBlocked(level, bodyText)) {
                return undefined;
            }

            const displayOptions = { ...options };
            displayOptions.positionClass = 'toast-top-center';
            if (!Object.prototype.hasOwnProperty.call(displayOptions, 'timeOut')) {
                displayOptions.timeOut = DEFAULT_TIMEOUTS[level] ?? 6500;
            }
            if (!Object.prototype.hasOwnProperty.call(displayOptions, 'extendedTimeOut')) {
                displayOptions.extendedTimeOut = Math.min(3000, Math.max(1500, displayOptions.timeOut / 3));
            }
            if (!Object.prototype.hasOwnProperty.call(displayOptions, 'progressBar')) {
                displayOptions.progressBar = true;
            }

            const toast = original(message, title, displayOptions);

            if (settings.shouldCapture(level) && !shouldSkipCapture(displayOptions) && bodyText) {
                settings.addToHistory(level, titleText, bodyText);
                liveHistory.push({
                    level,
                    title: titleText,
                    body: bodyText,
                    timestamp: new Date().toISOString(),
                    onclick: displayOptions?.onclick || null,
                });

                totalCount++;
                updateBadge();

                if (panelOpen) {
                    renderEntries();
                }
            }

            return toast;
        };

        wrapped[WRAP_FLAG] = true;
        toastApi[level] = wrapped;
    }

    toastApi[ORIGINALS_FLAG] = originals;
    toastApi[PATCH_FLAG] = true;
    window[ORIGINALS_FLAG] = originals;
    window[PATCH_FLAG] = true;

    return allLevelsWrapped || Object.keys(LEVEL_META).some(level => toastApi[level]?.[WRAP_FLAG] === true);
}

function schedulePatchRetry() {
    if (patchRetryTimer) return;
    patchRetryTimer = setTimeout(() => {
        patchRetryTimer = null;
        if (!interceptToastr()) {
            schedulePatchRetry();
        }
    }, RETRY_PATCH_DELAY_MS);
}

function ensureToastrIsDefault() {
    if (!interceptToastr()) {
        schedulePatchRetry();
    }

    if (!patchWatchdogTimer) {
        patchWatchdogTimer = setInterval(() => {
            if (!interceptToastr()) {
                schedulePatchRetry();
            }
        }, WATCHDOG_PATCH_INTERVAL_MS);
    }
}

// ─── Load persisted history on init ──────────────────────────
function loadPersistedHistory() {
    settings.pruneHistory();
    totalCount = settings.history.length;
    suppressedCount = settings.history.filter(h => settings.isBlocked(h.level, h.body)).length;
    updateBadge();
}

// ─── Slash Command ───────────────────────────────────────────
function registerSlashCommands() {
    if (!SlashCommandParser.commands?.toasttome) {
        SlashCommandParser.addCommandObject(SlashCommand.fromProps({
            name: 'toasttome',
            callback: (args, value) => {
                togglePanel();
                return '';
            },
            helpString: 'Open the Toast Tome panel.',
        }));
    }

    if (!SlashCommandParser.commands?.['toasttome-blocks']) {
        SlashCommandParser.addCommandObject(SlashCommand.fromProps({
            name: 'toasttome-blocks',
            callback: (args, value) => {
                const blocks = settings.hideList;
                if (blocks.length === 0) {
                    notifyInternal('info', 'No suppressed toasts.', 'Toast Tome');
                } else {
                    const text = blocks.map(b => `[${b.level}] ${b.textContent}`).join('\n');
                    notifyInternal('info', `${blocks.length} suppressed:\n${text}`, 'Toast Tome');
                }
                return '';
            },
            helpString: 'List suppressed toast patterns.',
        }));
    }
}

// ─── Init ────────────────────────────────────────────────────
const init = () => {
    loadMobileStylesheet();
    createBadge();
    createPanel();
    ensureToastrIsDefault();
    loadPersistedHistory();
    registerSlashCommands();

    // Keyboard shortcut: Escape returns from concealments before closing the panel
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && panelOpen) {
            if (suppressionManagerOpen) {
                closeSuppressionManager();
            } else {
                closePanel();
            }
        }
    });
};

function isExtensionDisabled() {
    const disabledExtensions = extension_settings.disabledExtensions || [];
    return EXTENSION_NAMES.some(name => disabledExtensions.includes(name));
}

function scheduleBadgeRemount(triesLeft = 5) {
    if (document.querySelector('#top-settings-holder .tt-badge') || mountRetryTimer) return;

    mountRetryTimer = setTimeout(() => {
        mountRetryTimer = null;
        const holder = document.querySelector('#top-settings-holder');
        if (holder && badgeEl && !holder.contains(badgeEl)) {
            badgeEl.classList.remove('tt-badge--floating');
            holder.prepend(badgeEl);
        } else if (triesLeft > 1) {
            scheduleBadgeRemount(triesLeft - 1);
        }
    }, 1500);
}

// Check if the extension is not disabled
if (!isExtensionDisabled()) {
    init();
    scheduleBadgeRemount();
}
